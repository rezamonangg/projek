# Production Environment Variables

# Server
PORT=8080

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=projek
DB_PASSWORD=projek
DB_NAME=projek

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
SESSION_TTL=168h
PASSWORD_MIN_LEN=12

# Email (SMTP) - Configure for production
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password
FROM_EMAIL=noreply@projek.example.com
FROM_NAME=Projek

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=/app/uploads

# AWS S3 (optional)
# AWS_REGION=us-east-1
# S3_BUCKET=projek-uploads
# S3_BASE_URL=https://s3.amazonaws.com
